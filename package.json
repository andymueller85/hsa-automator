{
  "name": "hsa-automator",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "sync": "tsx src/hsa-sync.ts",
    "dry-run": "tsx src/hsa-sync.ts --dry-run",
    "watch": "tsx src/hsa-sync.ts --watch",
    "demo:reset": "tsx src/demo/demo.ts --demo",
    "demo:sync": "tsx src/hsa-sync.ts --demo",
    "demo:dry-run": "tsx src/hsa-sync.ts --demo --dry-run",
    "demo:watch": "tsx src/hsa-sync.ts --demo --watch",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "chokidar": "^6.0.0",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
